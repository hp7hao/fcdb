# Temporary build artifacts and cache
build/
dist/
releases/

# Large binaries / Assets
/platforms/*
# Track pico8 platform including BBS carts and thumbs
!/platforms/pico8/
# Track pyxel thumbs only
!/platforms/pyxel/
/platforms/pyxel/*
!/platforms/pyxel/thumbs/

# Track PyxelPico single-file cart zips
!/platforms/pyxelpico/
/platforms/pyxelpico/*
!/platforms/pyxelpico/carts/
/platforms/pyxelpico/carts/*
!/platforms/pyxelpico/carts/pyxelpico/
!/platforms/pyxelpico/runtimes/
/platforms/pyxelpico/runtimes/*
!/platforms/pyxelpico/runtimes/pyxelpico/
/platforms/pyxelpico/runtimes/pyxelpico/*
!/platforms/pyxelpico/runtimes/pyxelpico/web/

# Track TIC-80 community carts and covers
!/platforms/tic80/
/platforms/tic80/*
!/platforms/tic80/carts/
!/platforms/tic80/thumbs/

# System files
.DS_Store
Thumbs.db
._*

# Editor directories
.vscode/
.idea/
*.swp

# Node modules (if any)
node_modules/
npm-debug.log

# Python cache
__pycache__/
*.py[cod]
