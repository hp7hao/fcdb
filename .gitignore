# Temporary build artifacts and cache
build/
dist/
releases/

# Large binaries / Assets
/platforms/*
# Track pico8 platform, but exclude BBS assets (too large)
!/platforms/pico8/
/platforms/pico8/carts/bbs/
/platforms/pico8/thumbs/bbs/
# Track pyxel thumbs only
!/platforms/pyxel/
/platforms/pyxel/*
!/platforms/pyxel/thumbs/

# System files
.DS_Store
Thumbs.db
._*

# Editor directories
.vscode/
.idea/
*.swp

# Node modules (if any)
node_modules/
npm-debug.log
